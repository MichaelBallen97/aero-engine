# tests/sdk/prefix.cmake -- task 4.5.1: what the installed prefix holds, and that a consumer builds and runs against it
# after the prefix MOVED. Needs sdk.install first (the fixture). Every list below is a literal on purpose: a check that
# read the install set from cmake/sdk_install.cmake would test the file against itself.
#
# Ids: SDK5 the libraries, SDK6 the header set, SDK7 what is absent, SDK8 shaders and package files, SDK9 a moved
# prefix configures and builds, SDK10 it runs from another folder, SDK11 nothing of the old prefix or vcpkg leaks.
cmake_minimum_required(VERSION 3.28)
include("${CMAKE_CURRENT_LIST_DIR}/sdk_common.cmake")

set(prefix "${WORK_ROOT}/prefix")
set(layers core assets audio platform rhi render reflect scene scene_render scene_audio scene_serialize)
set(excludedHeaders profiler.hpp animation_cook.hpp audio_cook.hpp mesh_cook.hpp skeleton_cook.hpp texture_cook.hpp
                    bc_block.hpp cooked_script.hpp)
if(NOT EXISTS "${prefix}/lib/cmake/AeroEngine/AeroEngineConfig.cmake")
    sdk_fail(SDK5 "no prefix at ${prefix}: sdk.install has not run")
endif()

# ---- SDK5: the libraries. Eleven engine archives, four third-party link files, DLLs on Windows only. ----------------
file(GLOB engineFiles LIST_DIRECTORIES false RELATIVE "${prefix}/lib" "${prefix}/lib/*")
list(LENGTH engineFiles engineCount)
if(NOT engineCount EQUAL 11)
    sdk_fail(SDK5 "lib/ holds ${engineCount} files, not the 11 engine libraries: ${engineFiles}")
endif()
foreach(layer IN LISTS layers)
    set(found 0)
    foreach(file IN LISTS engineFiles)
        if(file MATCHES "^(lib)?aero_${layer}\\.(a|lib)$")
            math(EXPR found "${found} + 1")
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        sdk_fail(SDK5 "lib/ holds ${found} files for the ${layer} layer: ${engineFiles}")
    endif()
endforeach()

file(GLOB thirdPartyFiles LIST_DIRECTORIES false RELATIVE "${prefix}/lib/third_party" "${prefix}/lib/third_party/*")
list(LENGTH thirdPartyFiles thirdPartyCount)
if(NOT thirdPartyCount EQUAL 4)
    sdk_fail(SDK5 "lib/third_party holds ${thirdPartyCount} files, not 4: ${thirdPartyFiles}")
endif()
foreach(name IN ITEMS spdlog fmt enkiTS SDL3)
    set(found 0)
    foreach(file IN LISTS thirdPartyFiles)
        if(file MATCHES "^(lib)?${name}[^/]*\\.(a|lib)$")
            math(EXPR found "${found} + 1")
        endif()
    endforeach()
    if(NOT found EQUAL 1)
        sdk_fail(SDK5 "lib/third_party holds ${found} files for ${name}: ${thirdPartyFiles}")
    endif()
endforeach()

if(CMAKE_HOST_WIN32)
    file(GLOB dlls LIST_DIRECTORIES false "${prefix}/bin/*.dll")
    list(LENGTH dlls dllCount)
    if(NOT dllCount EQUAL 4)
        sdk_fail(SDK5 "bin/ holds ${dllCount} DLLs, not 4: ${dlls}")
    endif()
elseif(EXISTS "${prefix}/bin")
    sdk_fail(SDK5 "a bin/ folder exists off Windows")
endif()

file(GLOB_RECURSE libraryFiles LIST_DIRECTORIES false RELATIVE "${prefix}" "${prefix}/lib/*.a" "${prefix}/lib/*.lib"
     "${prefix}/bin/*")
foreach(file IN LISTS libraryFiles)
    string(TOLOWER "${file}" lowered)
    foreach(forbidden IN ITEMS script tracy quickjs imgui)
        if(lowered MATCHES "${forbidden}")
            sdk_fail(SDK5 "${file} names ${forbidden}, which an SDK never ships")
        endif()
    endforeach()
endforeach()

# ---- SDK6: the header set -- the eleven layer folders, and every header of their source trees but the eight. --------
file(GLOB topEntries LIST_DIRECTORIES true RELATIVE "${prefix}/include" "${prefix}/include/*")
if(NOT topEntries STREQUAL "aero")
    sdk_fail(SDK6 "include/ holds '${topEntries}', not only aero/")
endif()
file(GLOB layerEntries LIST_DIRECTORIES true RELATIVE "${prefix}/include/aero" "${prefix}/include/aero/*")
list(SORT layerEntries)
set(expectedLayers ${layers})
list(SORT expectedLayers)
if(NOT layerEntries STREQUAL expectedLayers)
    sdk_fail(SDK6 "include/aero holds '${layerEntries}', expected the eleven layer folders '${expectedLayers}'")
endif()

set(sourceHeaders "")
foreach(layer IN LISTS layers)
    file(GLOB_RECURSE found LIST_DIRECTORIES false "${SOURCE_DIR}/engine/${layer}/include/*")
    list(APPEND sourceHeaders ${found})
endforeach()
list(LENGTH sourceHeaders sourceCount)
set(excludedSeen 0)
foreach(header IN LISTS sourceHeaders)
    get_filename_component(headerName "${header}" NAME)
    if(headerName IN_LIST excludedHeaders)
        math(EXPR excludedSeen "${excludedSeen} + 1")
    endif()
endforeach()
if(NOT excludedSeen EQUAL 8)
    sdk_fail(SDK6 "the source trees hold ${excludedSeen} of the 8 excluded headers: the literal list has gone stale")
endif()
math(EXPR expectedCount "${sourceCount} - 8")
file(GLOB_RECURSE installedHeaders LIST_DIRECTORIES false RELATIVE "${prefix}/include" "${prefix}/include/*")
list(LENGTH installedHeaders installedCount)
if(NOT installedCount EQUAL expectedCount)
    sdk_fail(SDK6 "include/ holds ${installedCount} headers; the source trees hold ${sourceCount}, minus 8 is ${expectedCount}")
endif()

# ---- SDK7: what is absent, and that no third-party name is a path segment. -----------------------------------------
foreach(name IN LISTS excludedHeaders)
    foreach(layer IN LISTS layers)
        if(EXISTS "${prefix}/include/aero/${layer}/${name}")
            sdk_fail(SDK7 "the excluded header ${layer}/${name} was installed")
        endif()
    endforeach()
endforeach()
if(EXISTS "${prefix}/include/aero/script")
    sdk_fail(SDK7 "aero/script was installed")
endif()
foreach(file IN LISTS installedHeaders)
    if(NOT file MATCHES "\\.hpp$")
        sdk_fail(SDK7 "include/${file} is not a .hpp")
    endif()
    string(REPLACE "/" ";" segments "${file}")
    foreach(segment IN LISTS segments)
        string(TOLOWER "${segment}" lowered)
        foreach(third IN ITEMS entt sdl3 spdlog fmt glm tracy miniaudio quickjs enkits)
            if(lowered STREQUAL third)
                sdk_fail(SDK7 "include/${file} has a third-party path segment '${segment}'")
            endif()
        endforeach()
    endforeach()
endforeach()

# ---- SDK8: shaders (four artifacts per source) and the package's five files. --------------------------------------
file(GLOB shaderSources LIST_DIRECTORIES false RELATIVE "${SOURCE_DIR}/shaders" "${SOURCE_DIR}/shaders/*.hlsl")
list(LENGTH shaderSources shaderSourceCount)
if(shaderSourceCount EQUAL 0)
    sdk_fail(SDK8 "no shaders/*.hlsl found under ${SOURCE_DIR}")
endif()
file(GLOB_RECURSE shaderFiles LIST_DIRECTORIES true RELATIVE "${prefix}/share/aero/shaders"
     "${prefix}/share/aero/shaders/*")
math(EXPR expectedShaders "4 * ${shaderSourceCount}")
list(LENGTH shaderFiles shaderFileCount)
if(NOT shaderFileCount EQUAL expectedShaders)
    sdk_fail(SDK8 "share/aero/shaders holds ${shaderFileCount} entries, expected ${expectedShaders}: ${shaderFiles}")
endif()
foreach(source IN LISTS shaderSources)
    get_filename_component(stem "${source}" NAME_WLE)
    foreach(extension IN ITEMS dxil json msl spv)
        if(NOT EXISTS "${prefix}/share/aero/shaders/${stem}.${extension}")
            sdk_fail(SDK8 "share/aero/shaders/${stem}.${extension} is missing")
        endif()
    endforeach()
endforeach()
if(EXISTS "${prefix}/share/aero/shaders/CMakeFiles")
    sdk_fail(SDK8 "a CMakeFiles folder was installed beside the shaders")
endif()
file(GLOB_RECURSE shaderCmake "${prefix}/share/aero/shaders/*.cmake")
if(shaderCmake)
    sdk_fail(SDK8 "a .cmake file was installed beside the shaders: ${shaderCmake}")
endif()
file(GLOB packageFiles LIST_DIRECTORIES true RELATIVE "${prefix}/lib/cmake/AeroEngine" "${prefix}/lib/cmake/AeroEngine/*")
list(SORT packageFiles)
set(expectedPackage AeroEngineConfig.cmake AeroEngineConfigVersion.cmake AeroEngineFiles.cmake AeroEngineGraph.cmake
                    aero_add_game.cmake)
list(SORT expectedPackage)
if(NOT packageFiles STREQUAL expectedPackage)
    sdk_fail(SDK8 "lib/cmake/AeroEngine holds '${packageFiles}', expected '${expectedPackage}'")
endif()

# ---- SDK9-SDK11: move the prefix (with a space in its path), build and run a consumer, put it back. ----------------
# Failures found while the prefix is away are collected and raised after the rename is undone, so a red run never
# leaves the next one without its prefix.
set(movedPrefix "${WORK_ROOT}/moved prefix")
file(REMOVE_RECURSE "${movedPrefix}")
file(RENAME "${prefix}" "${movedPrefix}")
set(failures "")
set(consumerSource "${CMAKE_CURRENT_LIST_DIR}/consumer")
set(binary "${WORK_ROOT}/consumer-build")
set(debugBinary "${WORK_ROOT}/consumer-build-debug")
set(elsewhere "${WORK_ROOT}/elsewhere")

sdk_configure_consumer(SOURCE "${consumerSource}" BINARY "${binary}" PREFIX "${movedPrefix}" OUTPUT configureOut
                       RESULT configureRc)
set(built FALSE)
if(NOT configureRc EQUAL 0)
    list(APPEND failures "SDK9: the consumer did not configure against the moved prefix (exit ${configureRc}):\n${configureOut}")
else()
    sdk_build_consumer(BINARY "${binary}" OUTPUT buildOut RESULT buildRc)
    if(NOT buildRc EQUAL 0)
        list(APPEND failures "SDK9: the consumer did not build against the moved prefix (exit ${buildRc}):\n${buildOut}")
    else()
        set(built TRUE)
    endif()
endif()

if(built)
    sdk_executable_path(exe "${binary}" aero_sdk_consumer)
    sdk_run_game(EXE "${exe}" WORKDIR "${elsewhere}" OUTPUT runOut RESULT runRc)
    if(NOT runRc EQUAL 0 OR NOT runOut MATCHES "consumer: layers=11")
        list(APPEND failures "SDK10: the consumer exited ${runRc} from another folder:\n${runOut}")
    endif()

    if(NOT CONSUMER_IS_MSVC)
        sdk_configure_consumer(SOURCE "${consumerSource}" BINARY "${debugBinary}" PREFIX "${movedPrefix}"
                               BUILD_TYPE Debug OUTPUT configureOut RESULT configureRc)
        sdk_build_consumer(BINARY "${debugBinary}" OUTPUT buildOut RESULT buildRc)
        if(NOT configureRc EQUAL 0 OR NOT buildRc EQUAL 0)
            list(APPEND failures "SDK10: the Debug consumer did not build (${configureRc}, ${buildRc}):\n${buildOut}")
        else()
            sdk_executable_path(debugExe "${debugBinary}" aero_sdk_consumer)
            sdk_run_game(EXE "${debugExe}" WORKDIR "${elsewhere}" OUTPUT runOut RESULT runRc)
            if(NOT runRc EQUAL 0 OR NOT runOut MATCHES "consumer: layers=11")
                list(APPEND failures "SDK10: the Debug consumer exited ${runRc}:\n${runOut}")
            endif()
        endif()
    endif()

    # SDK11: separators normalised and the shell's quoting undone, the compile line holds the moved include folder
    # and no vcpkg folder; the cache holds no trace of the old prefix.
    file(READ "${binary}/compile_commands.json" compileCommands)
    file(READ "${binary}/CMakeCache.txt" cache)
    string(REPLACE "\\" "/" compileCommands "${compileCommands}")
    string(REGEX REPLACE "/+" "/" compileCommands "${compileCommands}")
    string(REPLACE "/ " " " compileCommands "${compileCommands}")
    file(TO_CMAKE_PATH "${movedPrefix}/include" expectedInclude)
    string(REGEX REPLACE "/+" "/" expectedInclude "${expectedInclude}")
    string(FIND "${compileCommands}" "${expectedInclude}" includeAt)
    if(includeAt EQUAL -1)
        list(APPEND failures "SDK11: the compile line does not hold ${expectedInclude}:\n${compileCommands}")
    endif()
    string(TOLOWER "${compileCommands}" loweredCommands)
    if(loweredCommands MATCHES "vcpkg")
        list(APPEND failures "SDK11: the compile line names vcpkg:\n${compileCommands}")
    endif()
    file(TO_CMAKE_PATH "${prefix}" oldPrefix)
    string(REPLACE "\\" "/" cache "${cache}")
    string(FIND "${cache}" "${oldPrefix}" oldAt)
    if(NOT oldAt EQUAL -1)
        list(APPEND failures "SDK11: CMakeCache.txt holds the old prefix path ${oldPrefix}")
    endif()
endif()

file(RENAME "${movedPrefix}" "${prefix}")
if(failures)
    list(JOIN failures "\n" joined)
    message(FATAL_ERROR "${joined}")
endif()

message(STATUS "sdk.prefix: SDK5 to SDK11 passed")
