# cmake/embed_run.cmake -- task E.6.1: run by cmake/embed.cmake's custom command as `cmake -P`, once per file.
# Writes one C++ translation unit holding INPUT's bytes as an integer array plus one accessor:
#
#     std::span<const std::uint8_t> <NAMESPACE>::<ACCESSOR>() noexcept;
#
# The INPUT checks repeat embed.cmake's configure-time ones, so a file replaced after configure is still
# caught. The output is written to a temporary and copied over only when different, so an unchanged input
# never recompiles the TU.
#
# MODE (task 4.2.2) is `font` (the default: the TrueType check, the span accessor above) or `text`, run by
# aero_embed_text_files: every byte of INPUT must be LF or printable ASCII (0x20-0x7e) -- a CR, a tab, a control
# byte or anything >= 0x80 is a FATAL_ERROR, never a silently different text -- and the accessor is
#
#     std::string_view <NAMESPACE>::<ACCESSOR>() noexcept;
#
# over a `const char` array whose every value fits a char, so the initialiser narrows nothing on any compiler.
cmake_minimum_required(VERSION 3.28)

foreach(variable IN ITEMS INPUT OUTPUT ACCESSOR HEADER NAMESPACE)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "embed: ${variable} is required")
    endif()
endforeach()
if(NOT DEFINED MODE OR "${MODE}" STREQUAL "")
    set(MODE font)
endif()
if(NOT MODE STREQUAL "font" AND NOT MODE STREQUAL "text")
    message(FATAL_ERROR "embed: MODE must be 'font' or 'text' (got '${MODE}')")
endif()
if(NOT ACCESSOR MATCHES "^[a-z][A-Za-z0-9]*$")
    message(FATAL_ERROR "embed: '${ACCESSOR}' is not a camelCase accessor")
endif()
if(NOT EXISTS "${INPUT}")
    message(FATAL_ERROR "embed: input '${INPUT}' does not exist")
endif()
file(SIZE "${INPUT}" inputSize)
if(inputSize EQUAL 0)
    message(FATAL_ERROR "embed: input '${INPUT}' is empty")
endif()
if(MODE STREQUAL "font")
    file(READ "${INPUT}" magic LIMIT 4 HEX)
    if(NOT magic STREQUAL "00010000")
        message(FATAL_ERROR "embed: input '${INPUT}' is not a TrueType font (first bytes '${magic}')")
    endif()
endif()

# Lower-case hex pairs -> "0xNN," -> a line break after every sixteenth element. CMake's regex has no {n}, so
# the sixteen-element pattern is spelled out.
file(READ "${INPUT}" hex HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
if(MODE STREQUAL "text")
    # Run on the flat stream, before the line breaks go in: every byte must be 0x0a or 0x20-0x7e.
    string(REGEX MATCH "0x(0[0-9b-f]|1[0-9a-f]|7f|[89a-f][0-9a-f])," bad "${bytes}")
    if(NOT bad STREQUAL "")
        message(FATAL_ERROR "embed: input '${INPUT}' is not 7-bit LF text (first refused byte ${bad})")
    endif()
endif()
set(element "0x[0-9a-f][0-9a-f],")
set(sixteen "")
foreach(i RANGE 1 16)
    string(APPEND sixteen "${element}")
endforeach()
string(REGEX REPLACE "(${sixteen})" "\\1\n" bytes "${bytes}")

# NO ABSOLUTE PATH anywhere in the generated text (embed.cmake's header says why): the header by its NAME --
# embed.cmake puts its directory on this source's include path -- and the input by its file name.
get_filename_component(headerName "${HEADER}" NAME)
get_filename_component(inputName "${INPUT}" NAME)
set(content "// GENERATED by cmake/embed_run.cmake from ${inputName} -- do not edit, do not commit.\n")
if(MODE STREQUAL "text")
    string(APPEND content "#include \"${headerName}\"\n\n#include <string_view>\n\n")
    string(APPEND content "namespace ${NAMESPACE} {\nnamespace {\nconst char DATA[] = {\n${bytes}\n};\n")
    string(APPEND content "}  // namespace\n\n")
    string(APPEND content "std::string_view ${ACCESSOR}() noexcept { return {DATA, sizeof(DATA)}; }\n\n")
else()
    string(APPEND content "#include \"${headerName}\"\n\n#include <cstdint>\n#include <span>\n\n")
    string(APPEND content "namespace ${NAMESPACE} {\nnamespace {\nconst std::uint8_t DATA[] = {\n${bytes}\n};\n")
    string(APPEND content "}  // namespace\n\n")
    string(APPEND content "std::span<const std::uint8_t> ${ACCESSOR}() noexcept { return DATA; }\n\n")
endif()
string(APPEND content "}  // namespace ${NAMESPACE}\n")

file(WRITE "${OUTPUT}.tmp" "${content}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
